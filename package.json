{
  "name": "davinci-console-demo",
  "version": "0.11.2",
  "private": false,
  "description": "[DEMO] DaVinci Resolve 调色/剪辑控制台：灰片还原（官方 LUT 自动匹配/下载）、三层 15 节点调色图、10 个风格库、黑白柔、遮罩/跟踪、剧本导入、交付审批。需要 macOS + DaVinci Resolve Studio + Resolve MCP。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host-impl.mjs",
    "host-base.mjs",
    "client.js",
    "lib/**/*.mjs",
    "lib/*.swift",
    "lib/*.py",
    "bin/**",
    "assets/luts/official/library.json",
    "README.md",
    "USER_MANUAL.md",
    "docs/**/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "davinci",
    "resolve",
    "color-grading",
    "lut",
    "mcp",
    "dsh-plugin",
    "video"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "os": [
    "darwin"
  ],
  "davinciConsole": {
    "platform": "darwin",
    "requires": {
      "resolve": "DaVinci Resolve Studio 18+（推荐 21.2）",
      "mcp": "davinci-resolve-mcp（工具名 resolve_*）",
      "binaries": [
        "ffmpeg",
        "ffprobe"
      ],
      "optional": [
        "unzip",
        "osascript",
        "sips",
        "say"
      ]
    },
    "notes": "LUT 官方包不随主包发布（授权原因），首次使用通过 restore.ensure 从厂商官方直链下载；本机已下载的 LUT 放在用户 LUT 目录或插件 data/luts/official。"
  }
}